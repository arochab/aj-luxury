{
  "name": "aj-luxury",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "check:analytics-boundary": "node --experimental-strip-types scripts/check-analytics-client-boundary.mjs",
    "check:analytics-artifacts": "node --experimental-strip-types scripts/check-analytics-client-boundary.mjs --artifacts",
    "test:analytics-build-canaries": "node scripts/check-analytics-build-canaries.mjs",
    "prebuild": "npm run check:analytics-boundary",
    "build": "vinext build",
    "postbuild": "npm run check:analytics-artifacts",
    "start": "vinext start",
    "deploy:preview": "npm run build && wrangler deploy --config dist/server/wrangler.json --name aj-luxury-preview",
    "test": "npm run build && npm run test:analytics-build-canaries && npm run test:analytics-types && node --experimental-strip-types --test tests/hero-video.test.mjs tests/motion-lifecycle.test.mjs tests/commerce-pricing.test.mjs tests/stock-privacy.test.mjs tests/backend-core.test.mjs tests/analytics-foundation.test.mjs tests/root-typecheck-delta.test.mjs && npm run test:identity-access && npm run test:email-data && node --test tests/d1-migrations.test.mjs && npm run test:email-data-d1 && node --test tests/i18n-dictionaries.test.mjs tests/i18n-provider.test.mjs tests/model-identity.test.mjs tests/product-gallery-layout.test.mjs tests/rendered-html.test.mjs && npm run test:lot2-policies",
    "test:analytics-types": "tsc --project tsconfig.analytics.json",
    "test:backend": "node --experimental-strip-types --test tests/backend-core.test.mjs",
    "test:d1-migrations": "npm run build && node --test tests/d1-migrations.test.mjs",
    "test:email-data": "node --experimental-strip-types --test tests/email-data-migration.test.mjs tests/email-data-rights.test.mjs",
    "test:email-data-d1": "node --test tests/email-data-d1.test.mjs",
    "test:identity-access": "node --experimental-strip-types --test tests/identity-access-migration.test.mjs tests/identity-access-security.test.mjs",
    "test:lot2-policies": "node --experimental-strip-types --test tests/lot2-policies.test.mjs tests/lot2-security.test.mjs",
    "prelint": "npm run check:analytics-boundary",
    "lint": "eslint app lib tests --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.1",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "imports": {
    "#analytics-server-only": {
      "react-server": "./lib/analytics/server-runtime-guard.ts",
      "workerd": "./lib/analytics/server-runtime-guard.ts",
      "worker": "./lib/analytics/server-runtime-guard.ts",
      "node": "./lib/analytics/server-runtime-guard.ts",
      "browser": "./lib/analytics/server-browser-forbidden.ts",
      "default": "./lib/analytics/server-runtime-guard.ts"
    },
    "#analytics-server-runtime": {
      "react-server": "./lib/analytics/runtime-allowed.ts",
      "workerd": "./lib/analytics/runtime-allowed.ts",
      "worker": "./lib/analytics/runtime-allowed.ts",
      "node": "./lib/analytics/runtime-allowed.ts",
      "browser": "./lib/analytics/server-browser-forbidden.ts",
      "default": "./lib/analytics/runtime-allowed.ts"
    }
  },
  "type": "module"
}
